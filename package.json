{
  "name": "car-rental",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev --workspace=client\" \"npm:dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
